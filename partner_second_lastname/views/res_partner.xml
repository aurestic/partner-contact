<odoo>
    <record id="partner_simple_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="partner_firstname.view_partner_simple_form" />
        <field name="arch" type="xml">
            <field name="firstname" position="attributes">
                <attribute name="required" add="(not lastname2)" separator=" and " />
            </field>
            <field name="lastname" position="attributes">
                <attribute name="required" add="(not lastname2)" separator=" and " />
            </field>
            <!-- Detrás de cada "lastname" de partner_firstname (uno se ve con el
                 orden "Apellidos Nombre" y el otro con "Nombre Apellidos") -->
            <xpath
                expr="//field[@name='lastname'][@invisible='not form_has_lastname_first']"
                position="after"
            >
                <field
                    name="lastname2"
                    invisible="not form_has_lastname_first"
                    required="not firstname and not lastname and not is_company and type == 'contact'"
                />
            </xpath>
            <xpath
                expr="//field[@name='lastname'][@invisible='form_has_lastname_first']"
                position="after"
            >
                <field
                    name="lastname2"
                    invisible="form_has_lastname_first"
                    required="not firstname and not lastname and not is_company and type == 'contact'"
                />
            </xpath>
        </field>
    </record>
    <record id="partner_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="partner_firstname.view_partner_form" />
        <field name="arch" type="xml">
            <!-- Main form -->
            <field name="firstname" position="attributes">
                <attribute name="required" add="(not lastname2)" separator=" and " />
            </field>
            <field name="lastname" position="attributes">
                <attribute name="required" add="(not lastname2)" separator=" and " />
            </field>
            <!-- Detrás de cada "lastname" de partner_firstname (uno se ve con el
                 orden "Apellidos Nombre" y el otro con "Nombre Apellidos") -->
            <xpath
                expr="//field[@name='lastname'][@invisible='not form_has_lastname_first']"
                position="after"
            >
                <field
                    name="lastname2"
                    invisible="not form_has_lastname_first"
                    required="not lastname2 and not lastname and not is_company and type == 'contact'"
                />
            </xpath>
            <xpath
                expr="//field[@name='lastname'][@invisible='form_has_lastname_first']"
                position="after"
            >
                <field
                    name="lastname2"
                    invisible="form_has_lastname_first"
                    required="not lastname2 and not lastname and not is_company and type == 'contact'"
                />
            </xpath>
            <!-- Inner contact form of child_ids -->
            <xpath
                expr="//field[@name='child_ids']/form//field[@name='firstname']"
                position="attributes"
            >
                <attribute name="required" add="(not lastname2)" separator=" and " />
            </xpath>
            <xpath
                expr="//field[@name='child_ids']/form//field[@name='lastname']"
                position="attributes"
            >
                <attribute name="required" add="(not lastname2)" separator=" and " />
            </xpath>
            <!-- Detrás de cada "lastname" de partner_firstname (uno se ve con el
                 orden "Apellidos Nombre" y el otro con "Nombre Apellidos") -->
            <xpath
                expr="//field[@name='child_ids']/form//field[@name='lastname'][@invisible='not form_has_lastname_first']"
                position="after"
            >
                <field
                    name="lastname2"
                    invisible="not form_has_lastname_first"
                    required="not lastname2 and not lastname and not is_company and type == 'contact'"
                />
            </xpath>
            <xpath
                expr="//field[@name='child_ids']/form//field[@name='lastname'][@invisible='form_has_lastname_first']"
                position="after"
            >
                <field
                    name="lastname2"
                    invisible="form_has_lastname_first"
                    required="not lastname2 and not lastname and not is_company and type == 'contact'"
                />
            </xpath>
        </field>
    </record>
</odoo>
